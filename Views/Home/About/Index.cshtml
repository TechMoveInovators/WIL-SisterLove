@{
    ViewBag.PageTitle = "About Us";
}

<!-- =============================================
     SELF-CONTAINED STYLES (scoped to .ab sections)
============================================== -->
<style>
    .ab {
        --a-purple: #3d1d68;
        --a-purple-dark: #24143d;
        --a-turquoise: #2ed5c6;
        --a-magenta: #c13b8a;
        --a-cream: #faf8f0;
        --a-text: #4a3a3a;
        --a-muted: #6f6462;

        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--a-text);
        line-height: 1.6;
    }

    .ab *,
    .ab *::before,
    .ab *::after {
        box-sizing: border-box;
    }

    .ab h2,
    .ab h3 {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        text-transform: none;
        letter-spacing: normal;
    }

    .ab .ab-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .ab .ab-label {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--a-magenta);
        margin-bottom: 0.75rem;
    }

    .ab .ab-heading {
        font-size: clamp(2rem, 3.6vw, 2.8rem);
        font-weight: 800;
        line-height: 1.15;
        color: var(--a-purple);
        margin: 0 0 1rem;
    }

    .ab .ab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 2rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    /* ---------- Who we are ---------- */
    .ab-who {
        padding: 6rem 0;
        background: #fff;
    }

    .ab-who .ab-who-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 4rem;
        align-items: center;
    }

    .ab-who .ab-who-text {
        position: relative;
        padding-left: 2rem;
        border-left: 4px solid transparent;
        border-image: linear-gradient(180deg, var(--a-turquoise), var(--a-magenta)) 1;
    }

    .ab-who .ab-who-text p {
        font-size: 1.1rem;
        color: var(--a-muted);
        line-height: 1.8;
        margin: 0 0 1.25rem;
    }

    .ab-who .ab-who-text p:last-child {
        margin-bottom: 0;
    }

    /* ---------- Mission / vision / values ---------- */
    .ab-drive {
        padding: 6rem 0;
        background: var(--a-cream);
    }

    .ab-drive .ab-section-head {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 3.5rem;
    }

    .ab-drive .ab-section-head p {
        font-size: 1.1rem;
        color: var(--a-muted);
        margin: 0;
    }

    .ab-drive .ab-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.75rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .ab-drive .ab-card {
        --accent: var(--a-purple);
        position: relative;
        background: #fff;
        border-radius: 24px;
        padding: 2.5rem 2rem 2.25rem;
        border: 1px solid rgba(61, 29, 104, 0.06);
        box-shadow: 0 8px 25px rgba(36, 20, 61, 0.06);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .ab-drive .ab-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 6px;
        background: var(--accent);
    }

    .ab-drive .ab-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 22px 45px rgba(36, 20, 61, 0.14);
    }

    .ab-drive .ab-card-purple { --accent: var(--a-purple); }
    .ab-drive .ab-card-turquoise { --accent: var(--a-turquoise); }
    .ab-drive .ab-card-magenta { --accent: var(--a-magenta); }

    .ab-drive .ab-card-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: var(--accent);
        color: #fff;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .ab-drive .ab-card h3 {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--a-purple);
        margin: 0 0 0.75rem;
    }

    .ab-drive .ab-card p {
        margin: 0;
        color: var(--a-muted);
        line-height: 1.75;
    }

    /* ---------- Our story ---------- */
    .ab-story {
        padding: 6rem 0;
        background: #fff;
    }

    .ab-story .ab-story-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 4rem;
        align-items: center;
    }

    .ab-story .ab-story-visual {
        position: relative;
        display: flex;
        justify-content: center;
    }

    .ab-story .ab-story-circle {
        width: min(100%, 460px);
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        padding: 10px;
        background: linear-gradient(135deg, var(--a-turquoise) 0%, var(--a-magenta) 100%);
        box-shadow: 0 25px 60px rgba(36, 20, 61, 0.2);
    }

    .ab-story .ab-story-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-size: cover;
        background-position: center;
        background-color: #ece6f3;
    }

    .ab-story .ab-story-badge {
        position: absolute;
        right: 0;
        bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        background: #fff;
        padding: 1rem 1.4rem;
        border-radius: 16px;
        box-shadow: 0 15px 35px rgba(36, 20, 61, 0.18);
    }

    .ab-story .ab-story-badge i {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--a-turquoise) 0%, var(--a-magenta) 100%);
        color: #fff;
    }

    .ab-story .ab-story-badge strong {
        display: block;
        color: var(--a-purple);
        font-weight: 800;
        line-height: 1.2;
    }

    .ab-story .ab-story-badge span {
        font-size: 0.8rem;
        color: var(--a-muted);
    }

    .ab-story .ab-story-content p {
        font-size: 1.05rem;
        color: var(--a-muted);
        line-height: 1.75;
        margin: 0 0 1rem;
    }

    .ab-story .ab-principles {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        margin-top: 1.75rem;
    }

    .ab-story .ab-principle {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: var(--a-cream);
        border-radius: 14px;
        border: 1px solid rgba(61, 29, 104, 0.06);
    }

    .ab-story .ab-principle i {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--a-purple);
        color: #fff;
    }

    .ab-story .ab-principle strong {
        display: block;
        color: var(--a-purple);
        font-weight: 700;
    }

    .ab-story .ab-principle span {
        font-size: 0.9rem;
        color: var(--a-muted);
    }

    /* ---------- CTA ---------- */
    .ab-cta {
        padding: 6rem 0;
        background: linear-gradient(135deg, var(--a-purple-dark) 0%, var(--a-purple) 55%, var(--a-magenta) 100%);
        text-align: center;
        color: #fff;
    }

    .ab-cta .ab-label {
        color: var(--a-turquoise);
    }

    .ab-cta h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.15;
        color: #fff;
        margin: 0 0 1rem;
    }

    .ab-cta p {
        max-width: 640px;
        margin: 0 auto 2rem;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.85);
    }

    .ab-cta .ab-cta-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .ab-cta .ab-btn-light {
        background: #fff;
        color: var(--a-purple);
    }

    .ab-cta .ab-btn-light:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    }

    .ab-cta .ab-btn-outline {
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: #fff;
    }

    .ab-cta .ab-btn-outline:hover {
        background: #fff;
        color: var(--a-purple);
        transform: translateY(-3px);
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1000px) {
        .ab-who .ab-who-grid,
        .ab-story .ab-story-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .ab-drive .ab-cards {
            grid-template-columns: 1fr;
            max-width: 560px;
        }
    }

    @@media (max-width: 768px) {
        .ab-who,
        .ab-drive,
        .ab-story,
        .ab-cta {
            padding: 4rem 0;
        }

        .ab-who .ab-who-text {
            padding-left: 1.25rem;
        }

        .ab-story .ab-story-badge {
            right: 0.5rem;
        }
    }
</style>

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">
            <span class="eyebrow">ABOUT US</span>
            <h1>
                Locally led.
                <span>Community rooted.</span>
            </h1>
            <p>
                SisterLove South Africa is a community-based organisation
                working alongside women, girls and young people to advance
                health, dignity, justice and opportunity across South Africa.
            </p>
            <div class="hero-actions">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                    Work With Us
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Home" asp-action="OurWork" class="btn btn-outline">
                    Explore Our Work
                </a>
            </div>
        </div>

        <!-- Circular hero image -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle">
                <div class="gi-hero-image"
                     style="background-image: url('/images/about-hero.jpg');"></div>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-hands-holding-heart"></i>
                <div>
                    <strong>Love in Action</strong>
                    <span>Health • Justice • Dignity</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     WHO WE ARE
============================================== -->
<section class="ab ab-who">
    <div class="ab-wrap">
        <div class="ab-who-grid">

            <div>
                <span class="ab-label">WHO WE ARE</span>
                <h2 class="ab-heading">Community-based. Community-driven.</h2>
            </div>

            <div class="ab-who-text">
                <p>
                    SisterLove South Africa is a locally led, volunteer-driven
                    organisation working alongside women, girls and young
                    people impacted by HIV, gender-based violence and barriers
                    to sexual and reproductive health.
                </p>
                <p>
                    Our work is grounded in feminist and human-rights principles,
                    and delivered through partnerships with communities, civil
                    society, government and local stakeholders.
                </p>
            </div>

        </div>
    </div>
</section>


<!-- =============================================
     MISSION • VISION • VALUES
============================================== -->
<section class="ab ab-drive">
    <div class="ab-wrap">

        <div class="ab-section-head">
            <span class="ab-label">WHAT DRIVES US</span>
            <h2 class="ab-heading">Mission, vision &amp; values</h2>
            <p>
                The beliefs and commitments that shape every part of our work.
            </p>
        </div>

        <div class="ab-cards">

            <!-- Mission -->
            <article class="ab-card ab-card-purple">
                <div class="ab-card-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <h3>Our Mission</h3>
                <p>
                    To advance HIV prevention, sexual and reproductive
                    health and justice, and gender equality for women
                    and girls in South Africa — through education,
                    advocacy and compassionate community support.
                </p>
            </article>

            <!-- Vision -->
            <article class="ab-card ab-card-turquoise">
                <div class="ab-card-icon">
                    <i class="fas fa-star"></i>
                </div>
                <h3>Our Vision</h3>
                <p>
                    A South Africa where every woman and girl lives with
                    dignity, free from violence, with full access to
                    quality healthcare and the freedom to shape her own
                    future.
                </p>
            </article>

            <!-- Values -->
            <article class="ab-card ab-card-magenta">
                <div class="ab-card-icon">
                    <i class="fas fa-heart"></i>
                </div>
                <h3>Our Values</h3>
                <p>
                    Love in action. Community leadership. Human rights.
                    Gender justice. Compassion, accountability and
                    partnership at every step of the work.
                </p>
            </article>

        </div>

    </div>
</section>


<!-- =============================================
     OUR STORY
============================================== -->
<section class="ab ab-story">
    <div class="ab-wrap">
        <div class="ab-story-grid">

            <!-- Circular image -->
            <div class="ab-story-visual">
                <div class="ab-story-circle">
                    <!-- Tries each common extension, so it works whichever one your file uses.
                         Once you know the exact name, you can keep just that one url(). -->
                    <div class="ab-story-image"
                         style="background-image: url('@Url.Content("~/images/us.jpg")'), url('@Url.Content("~/images/us.jpeg")'), url('@Url.Content("~/images/us.png")'), url('@Url.Content("~/images/us.webp")'), url('@Url.Content("~/images/us.JPG")');"></div>
                </div>
                <div class="ab-story-badge">
                    <i class="fas fa-users"></i>
                    <div>
                        <strong>Volunteer-Driven</strong>
                        <span>People • Purpose • Progress</span>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="ab-story-content">
                <span class="ab-label">OUR STORY</span>
                <h2 class="ab-heading">Built on love. Led by community.</h2>
                <p>
                    SisterLove South Africa grew out of a simple belief: that
                    meaningful change happens when communities lead the work
                    themselves — when people closest to the challenges help
                    shape the solutions.
                </p>
                <p>
                    Today we continue to work through volunteers, consultants,
                    civil society, government and community partners to deliver
                    programmes that respond to real, local needs.
                </p>

                <!-- Key principles -->
                <div class="ab-principles">
                    <div class="ab-principle">
                        <i class="fas fa-users"></i>
                        <div>
                            <strong>Community Leadership</strong>
                            <span>Communities are central to the change we seek.</span>
                        </div>
                    </div>
                    <div class="ab-principle">
                        <i class="fas fa-scale-balanced"></i>
                        <div>
                            <strong>Human Rights</strong>
                            <span>Dignity, equality and justice for all.</span>
                        </div>
                    </div>
                    <div class="ab-principle">
                        <i class="fas fa-heart"></i>
                        <div>
                            <strong>Love in Action</strong>
                            <span>Compassion turned into meaningful, lasting work.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="ab ab-cta">
    <div class="ab-wrap">
        <span class="ab-label">JOIN US</span>
        <h2>Change happens when we act together.</h2>
        <p>
            Whether you volunteer, partner with us or support our work,
            there are many ways to help advance health, justice and
            dignity for women and girls.
        </p>
        <div class="ab-cta-actions">
            <a asp-controller="Home" asp-action="GetInvolved" class="ab-btn ab-btn-light">
                Get Involved
            </a>
            <a asp-controller="Donate" asp-action="Index" class="ab-btn ab-btn-outline">
                Support Our Work
            </a>
        </div>
    </div>
</section>
