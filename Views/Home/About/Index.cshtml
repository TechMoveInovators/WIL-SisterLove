@{
    ViewBag.PageTitle = "About Us";
}

<section style="padding: 4rem 0;">
    <div class="container">
        <h1 class="section-title">About Us</h1>
        <div class="about-grid">
            <div class="about-card">
                <i class="fas fa-hand-holding-heart fa-3x" style="color:#c0392b;"></i>
                <h2>Who We Are</h2>
                <p>SisterLove South Africa is a community-based organization supporting women and girls impacted by abuse, HIV, and reproductive health challenges.</p>
            </div>
            <div class="about-card">
                <i class="fas fa-bullseye fa-3x" style="color:#c0392b;"></i>
                <h2>Our Mission</h2>
                <p>To end HIV and uphold reproductive health rights for all women and girls in South Africa through education, advocacy, and compassionate support.</p>
            </div>
            <div class="about-card">
                <i class="fas fa-star fa-3x" style="color:#c0392b;"></i>
                <h2>Our Vision</h2>
                <p>A South Africa where every woman and girl lives with dignity, free from violence, with access to quality healthcare.</p>
            </div>
        </div>
    </div>
</section>