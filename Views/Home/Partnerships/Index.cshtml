@{
    ViewBag.PageTitle = "Partnerships";
}

<section class="partnerships-page">

    <!-- Hero -->
    <section class="partnerships-hero">
        <div class="container">

            <div class="partnerships-hero-content">

                <span class="section-label">
                    PARTNERSHIPS & STAKEHOLDERS
                </span>

                <h1>
                    Change is stronger
                    <span>together.</span>
                </h1>

                <p>
                    SisterLove South Africa works alongside organisations,
                    government, civil society and community stakeholders to
                    strengthen health, justice and community-led change.
                </p>

            </div>

        </div>
    </section>


    <!-- Introduction -->
    <section class="partnerships-intro">

        <div class="container">

            <div class="partnerships-intro-grid">

                <div>

                    <span class="section-label">
                        COLLABORATION
                    </span>

                    <h2>
                        Building meaningful
                        partnerships.
                    </h2>

                </div>

                <div>

                    <p>
                        Our partnerships allow us to connect communities,
                        organisations and stakeholders around shared
                        priorities in sexual and reproductive health,
                        HIV prevention, gender justice and youth
                        empowerment.
                    </p>

                    <p>
                        We value relationships that are locally relevant,
                        collaborative and grounded in human rights.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Partners -->
    <section class="partners-section">

        <div class="container">

            <div class="work-section-heading">

                <span class="section-label">
                    OUR NETWORK
                </span>

                <h2>
                    Partners and stakeholders
                </h2>

                <p>
                    SisterLove South Africa has worked with and alongside
                    organisations and stakeholders including:
                </p>

            </div>


            <div class="partner-grid">

                <div class="partner-card">
                    <div class="partner-icon">
                        <i class="fas fa-hashtag"></i>
                    </div>

                    <h3>Show Me Your Number</h3>

                    <p>
                        A partner connected to community engagement,
                        human rights and advocacy work.
                    </p>
                </div>


                <div class="partner-card">
                    <div class="partner-icon">
                        <i class="fas fa-heart"></i>
                    </div>

                    <h3>Gugu Dlamini Foundation</h3>

                    <p>
                        Working within the broader HIV, health and
                        human-rights landscape.
                    </p>
                </div>


                <div class="partner-card">
                    <div class="partner-icon">
                        <i class="fas fa-people-group"></i>
                    </div>

                    <h3>Sonke Gender Justice</h3>

                    <p>
                        A civil society organisation working toward
                        gender equality and justice.
                    </p>
                </div>


                <div class="partner-card">
                    <div class="partner-icon">
                        <i class="fas fa-landmark"></i>
                    </div>

                    <h3>Department of Sports and Culture</h3>

                    <p>
                        Supporting opportunities for youth engagement,
                        sport and community development.
                    </p>
                </div>


                <div class="partner-card">
                    <div class="partner-icon">
                        <i class="fas fa-city"></i>
                    </div>

                    <h3>Local Government & Community Stakeholders</h3>

                    <p>
                        Working with local stakeholders to respond to
                        community priorities.
                    </p>
                </div>


                <div class="partner-card">
                    <div class="partner-icon">
                        <i class="fas fa-comments"></i>
                    </div>

                    <h3>Civil Society Forum</h3>

                    <p>
                        Connecting with civil society networks and
                        collective advocacy initiatives.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="partnerships-cta">

        <div class="container">

            <div class="partnerships-cta-content">

                <span class="section-label">
                    WORK WITH US
                </span>

                <h2>
                    Let's build stronger
                    communities together.
                </h2>

                <p>
                    Interested in partnering with SisterLove South Africa?
                    We'd love to hear from you.
                </p>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="btn-primary">
                    Start a Conversation
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>

    </section>

</section>