@{
    ViewBag.PageTitle = "Track Record";
}

<section class="track-record-page">

    <!-- Hero -->
    <section class="track-record-hero">

        <div class="container">

            <div class="track-record-hero-content">

                <span class="section-label">
                    OUR TRACK RECORD
                </span>

                <h1>
                    Building on work
                    that came <span>before.</span>
                </h1>

                <p>
                    Our previous programmes and initiatives form part of
                    SisterLove South Africa's continuing commitment to
                    health, justice, dignity and community empowerment.
                </p>

            </div>

        </div>

    </section>


    <!-- Legacy Introduction -->
    <section class="track-record-intro">

        <div class="container">

            <div class="track-record-intro-grid">

                <div>

                    <span class="section-label">
                        PREVIOUS & LEGACY WORK
                    </span>

                    <h2>
                        Experience that
                        continues to inform our work.
                    </h2>

                </div>

                <div>

                    <p>
                        SisterLove South Africa's history includes
                        programmes focused on HIV prevention, sexual and
                        reproductive health, human rights, women and girls,
                        and community empowerment.
                    </p>

                    <p>
                        These initiatives contribute to the experience,
                        relationships and knowledge that continue to shape
                        our work today.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Projects -->
    <section class="legacy-projects">

        <div class="container">

            <div class="work-section-heading">

                <span class="section-label">
                    LEGACY PROGRAMMES
                </span>

                <h2>
                    Previous initiatives
                </h2>

            </div>


            <div class="legacy-grid">

                <!-- DREAMS -->
                <article class="legacy-card">

                    <div class="legacy-year">
                        2016–2019
                    </div>

                    <div class="legacy-icon">
                        <i class="fas fa-seedling"></i>
                    </div>

                    <h3>
                        DREAMS
                    </h3>

                    <p>
                        A programme focused on reducing HIV risk among
                        adolescent girls and young women through
                        prevention, education and community-based support.
                    </p>

                    <span class="legacy-support">
                        Supported through PEPFAR
                    </span>

                </article>


                <!-- Healthy Love Parties -->
                <article class="legacy-card">

                    <div class="legacy-icon">
                        <i class="fas fa-heart"></i>
                    </div>

                    <h3>
                        Healthy Love Parties
                    </h3>

                    <p>
                        Community-based engagement supporting conversations
                        around sexual health, HIV prevention and healthy
                        relationships.
                    </p>

                </article>


                <!-- POWaR -->
                <article class="legacy-card">

                    <div class="legacy-icon">
                        <i class="fas fa-bolt"></i>
                    </div>

                    <h3>
                        POWaR
                    </h3>

                    <p>
                        A previous initiative forming part of SisterLove
                        South Africa's broader programme and community
                        engagement work.
                    </p>

                </article>


                <!-- SILC -->
                <article class="legacy-card">

                    <div class="legacy-icon">
                        <i class="fas fa-users"></i>
                    </div>

                    <h3>
                        SILC
                    </h3>

                    <p>
                        A previous programme contributing to community
                        support, participation and empowerment.
                    </p>

                </article>


                <!-- Show Me Your Number -->
                <article class="legacy-card legacy-card-wide">

                    <div class="legacy-icon">
                        <i class="fas fa-scale-balanced"></i>
                    </div>

                    <div>

                        <h3>
                            Show Me Your Number —
                            Human Rights in Western Cape
                        </h3>

                        <p>
                            A human-rights initiative in the Western Cape
                            supported through the Global Fund.
                        </p>

                        <span class="legacy-support">
                            Supported by the Global Fund
                        </span>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="track-record-cta">

        <div class="container">

            <div class="track-record-cta-content">

                <h2>
                    Help us build what comes next.
                </h2>

                <p>
                    Our previous work provides a foundation for continued
                    community-led action.
                </p>

                <a asp-controller="Donate"
                   asp-action="Index"
                   class="btn-primary">
                    Support Our Work
                </a>

            </div>

        </div>

    </section>

</section>