<!-- CSS FOR CIRCULAR SLIDESHOW                 -->
<!-- ========================================== -->
<style>
    /* Container for the visual area */
    .hero-visual {
        position: relative;
        width: 100%;
        max-width: 550px; /* Adjust based on your layout */
        aspect-ratio: 1 / 1; /* Keeps it a perfect circle */
        margin: 0 auto;
    }

    /* The circular mask */
    .circle-slideshow-container {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 50%; /* Makes it a circle */
        overflow: hidden; /* Hides image edges */
        box-shadow: 0 10px 30px rgba(0,0,0,0.15); /* Soft shadow */
        background-color: #6a35c9; /* Fallback purple */
    }

    /* Individual Slides */
    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transition: opacity 1.5s ease-in-out; /* Smooth crossfade */
        z-index: 1;
    }

    /* Active slide is visible */
    .slide.active {
        opacity: 1;
        z-index: 2;
    }

    /* Center "Love in Action" Badge */
    .center-badge {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 140px;
        height: 140px;
        background-color: #20c4d1; /* Cyan/teal */
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #000;
        font-weight: bold;
        font-size: 14px;
        z-index: 10; /* Above the slides */
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        text-align: center;
    }

    .center-badge .heart-icon {
        font-size: 24px;
        margin-bottom: 5px;
    }

    /* Floating Card (South Africa Badge) */
    /* Assuming you already have styles for .floating-card,
       but here is a fallback just in case */
    .floating-card {
        position: absolute;
        bottom: -20px;
        left: -20px;
        background-color: #f2b8b5; /* Pink/peach */
        padding: 15px 25px;
        border-radius: 12px;
        z-index: 20;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
    }

    .floating-card strong {
        margin: 0 0 5px 0;
        font-size: 16px;
    }

    .floating-card span {
        margin: 0;
        font-size: 12px;
        color: #333;
    }
</style>
<!-- JAVASCRIPT FOR AUTOMATIC SLIDESHOW         -->

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slides = document.querySelectorAll('.slide');
            let currentSlide = 0;
            const slideInterval = 4000; // Changes image every 4 seconds

            function nextSlide() {
                // Remove active class from current slide
                slides[currentSlide].classList.remove('active');

                // Move to next slide, loop back to 0 if at the end
                currentSlide = (currentSlide + 1) % slides.length;

                // Add active class to new slide
                slides[currentSlide].classList.add('active');
            }

            // Start the automatic slideshow
            setInterval(nextSlide, slideInterval);
        });
    </script>
}