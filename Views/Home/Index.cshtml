@{
    ViewBag.PageTitle = "Home";
}

<!-- HERO -->
<section class="hero-section">

    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">

            <span class="eyebrow">
                SISTERLOVE SOUTH AFRICA
            </span>

            <h1>
                Locally led.
                <span>Community rooted.</span>
            </h1>

            <p>
                A South African organisation advancing HIV prevention,
                sexual and reproductive health and justice, gender justice,
                and youth empowerment through community engagement,
                education, sport and partnerships.
            </p>

            <div class="hero-actions">

                <a href="#our-work"
                   class="btn btn-primary">
                    Explore Our Work
                    <i class="fas fa-arrow-right"></i>
                </a>

                <a href="/Contact"
                   class="btn btn-outline">
                    Partner With Us
                </a>

            </div>

        </div>

        <div class="hero-visual">

            <div class="hero-photo-placeholder">
                <div>
                    <i class="fas fa-heart"></i>
                    <span>Love in Action</span>
                </div>
            </div>

            <div class="floating-card">
                <strong>South Africa</strong>
                <span>Community • Justice • Action</span>
            </div>

        </div>

    </div>
</section>


<!-- INTRODUCTION -->
<section class="intro-section">

    <div class="container intro-grid">

        <div>
            <span class="section-label">
                WHO WE ARE
            </span>

            <h2>
                Building healthier,
                safer and more
                empowered communities.
            </h2>
        </div>

        <div>
            <p>
                SisterLove South Africa is a locally led,
                volunteer-driven organisation working through
                partnerships and community engagement.
            </p>

            <p>
                Our work focuses on HIV prevention, sexual and
                reproductive health and justice, gender-based
                violence prevention and youth empowerment.
            </p>

            <a href="/Home/About"
               class="text-link">
                Learn more about us
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </div>

</section>


<!-- FOCUS AREAS -->
<section class="focus-section"
         id="our-work">

    <div class="container">

        <div class="section-heading">

            <span class="section-label">
                OUR WORK
            </span>

            <h2>
                Our focus areas
            </h2>

            <p>
                Through education, prevention, advocacy,
                sport and community partnerships, SLiSA
                works to create meaningful change.
            </p>

        </div>


        <div class="focus-grid">

            <article class="focus-card focus-purple">

                <div class="focus-icon">
                    <i class="fas fa-ribbon"></i>
                </div>

                <h3>
                    HIV Prevention
                    & Education
                </h3>

                <p>
                    Community education, awareness,
                    prevention and support for women
                    and young people.
                </p>

                <a href="#">
                    Explore
                    <i class="fas fa-arrow-right"></i>
                </a>

            </article>


            <article class="focus-card focus-blue">

                <div class="focus-icon">
                    <i class="fas fa-heart-pulse"></i>
                </div>

                <h3>
                    Sexual & Reproductive
                    Health & Justice
                </h3>

                <p>
                    Promoting rights, bodily autonomy,
                    access to information and
                    empowerment.
                </p>

                <a href="#">
                    Explore
                    <i class="fas fa-arrow-right"></i>
                </a>

            </article>


            <article class="focus-card focus-magenta">

                <div class="focus-icon">
                    <i class="fas fa-hand-fist"></i>
                </div>

                <h3>
                    Gender-Based Violence
                    & Femicide
                </h3>

                <p>
                    Prevention, gender justice,
                    awareness campaigns and
                    community advocacy.
                </p>

                <a href="#">
                    Explore
                    <i class="fas fa-arrow-right"></i>
                </a>

            </article>


            <article class="focus-card focus-turquoise">

                <div class="focus-icon">
                    <i class="fas fa-futbol"></i>
                </div>

                <h3>
                    Youth Empowerment
                    Through Sport
                </h3>

                <p>
                    Using sport and community activities
                    to engage young people and encourage
                    dialogue.
                </p>

                <a href="#">
                    Explore
                    <i class="fas fa-arrow-right"></i>
                </a>

            </article>

        </div>

    </div>

</section>


<!-- LOCALLY LED -->
<section class="identity-section">

    <div class="container identity-grid">

        <div class="identity-visual">

            <div class="identity-pattern">
                <span>SLiSA</span>
            </div>

        </div>

        <div class="identity-content">

            <span class="section-label">
                OUR IDENTITY
            </span>

            <h2>
                Locally led.
                Community rooted.
            </h2>

            <p>
                SisterLove South Africa is grounded in
                local leadership and community relationships.
            </p>

            <p>
                We work through volunteers, consultants,
                civil society, government and community
                stakeholders to support meaningful
                programmes and partnerships.
            </p>

            <a href="/Home/About"
               class="btn btn-primary">
                Discover Our Story
            </a>

        </div>

    </div>

</section>


<!-- TRACK RECORD -->
<section class="track-record-section"
         id="legacy">

    <div class="container">

        <div class="section-heading">

            <span class="section-label">
                OUR TRACK RECORD
            </span>

            <h2>
                Experience that continues
                to shape our work.
            </h2>

        </div>

        <div class="track-record-grid">

            <div class="track-card">
                <span>2016–2019</span>
                <h3>DREAMS Programme</h3>
                <p>
                    Previous HIV prevention work
                    supporting adolescent girls
                    and young women.
                </p>
            </div>

            <div class="track-card">
                <span>Human Rights</span>
                <h3>Show Me Your Number</h3>
                <p>
                    Human rights work in the Western Cape,
                    supported by The Global Fund.
                </p>
            </div>

            <div class="track-card">
                <span>Gender Justice</span>
                <h3>Sonke Gender Justice</h3>
                <p>
                    Collaboration focused on GBVF
                    prevention and gender justice.
                </p>
            </div>

        </div>

    </div>

</section>


<!-- GET INVOLVED -->
<section class="cta-section"
         id="get-involved">

    <div class="container">

        <div class="cta-content">

            <span class="section-label">
                GET INVOLVED
            </span>

            <h2>
                Love in action starts
                with people.
            </h2>

            <p>
                Whether you want to volunteer,
                partner with us or support our work,
                there are ways to get involved.
            </p>

            <div class="cta-actions">

                <a href="/Contact"
                   class="btn btn-light">
                    Partner With Us
                </a>

                <a href="/Donate"
                   class="btn btn-outline-light">
                    Support Our Work
                </a>

            </div>

        </div>

    </div>

</section>