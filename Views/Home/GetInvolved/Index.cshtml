@{
    ViewBag.PageTitle = "Get Involved";
}

<section class="get-involved-page">

    <!-- Hero -->
    <section class="get-involved-hero">

        <div class="container">

            <div class="get-involved-hero-content">

                <span class="section-label">
                    GET INVOLVED
                </span>

                <h1>
                    There is always
                    a way to <span>help.</span>
                </h1>

                <p>
                    Whether you volunteer your time, build a partnership,
                    support our programmes or help amplify our work,
                    your contribution can make a difference.
                </p>

            </div>

        </div>

    </section>


    <!-- Ways to Get Involved -->
    <section class="involvement-options">

        <div class="container">

            <div class="work-section-heading">

                <span class="section-label">
                    TAKE ACTION
                </span>

                <h2>
                    How you can support our work
                </h2>

            </div>


            <div class="involvement-grid">

                <!-- Volunteer -->
                <article class="involvement-card">

                    <div class="involvement-icon">
                        <i class="fas fa-hands-helping"></i>
                    </div>

                    <h3>
                        Volunteer
                    </h3>

                    <p>
                        Give your time, skills and experience to support
                        community-led work and initiatives.
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="work-card-link">
                        Volunteer with us
                        <i class="fas fa-arrow-right"></i>
                    </a>

                </article>


                <!-- Partner -->
                <article class="involvement-card">

                    <div class="involvement-icon">
                        <i class="fas fa-handshake"></i>
                    </div>

                    <h3>
                        Become a Partner
                    </h3>

                    <p>
                        Work with SisterLove South Africa to develop
                        meaningful programmes, initiatives and
                        community collaborations.
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="work-card-link">
                        Explore partnership
                        <i class="fas fa-arrow-right"></i>
                    </a>

                </article>


                <!-- Donate -->
                <article class="involvement-card">

                    <div class="involvement-icon">
                        <i class="fas fa-heart"></i>
                    </div>

                    <h3>
                        Support Our Work
                    </h3>

                    <p>
                        Financial support helps us continue our programmes,
                        community engagement and advocacy work.
                    </p>

                    <a asp-controller="Donate"
                       asp-action="Index"
                       class="work-card-link">
                        Support our work
                        <i class="fas fa-arrow-right"></i>
                    </a>

                </article>


                <!-- Spread the Word -->
                <article class="involvement-card">

                    <div class="involvement-icon">
                        <i class="fas fa-bullhorn"></i>
                    </div>

                    <h3>
                        Spread the Word
                    </h3>

                    <p>
                        Help raise awareness by sharing our work,
                        initiatives and messages with your networks.
                    </p>

                    <a href="#"
                       class="work-card-link">
                        Follow our work
                        <i class="fas fa-arrow-right"></i>
                    </a>

                </article>

            </div>

        </div>

    </section>


    <!-- Volunteer Section -->
    <section class="volunteer-section">

        <div class="container">

            <div class="volunteer-grid">

                <div class="volunteer-content">

                    <span class="section-label">
                        VOLUNTEERING
                    </span>

                    <h2>
                        Your time can make
                        a difference.
                    </h2>

                    <p>
                        SisterLove South Africa is currently
                        volunteer-driven and works with people who
                        contribute their skills, knowledge and time to
                        advance our mission.
                    </p>

                    <p>
                        If you are interested in volunteering, use our
                        contact form and select <strong>Volunteering</strong>
                        as your reason for contacting us.
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="btn-primary">
                        Volunteer With Us
                        <i class="fas fa-arrow-right"></i>
                    </a>

                </div>


                <div class="volunteer-highlight">

                    <div class="highlight-icon">
                        <i class="fas fa-heart"></i>
                    </div>

                    <h3>
                        Love in Action
                    </h3>

                    <p>
                        We believe meaningful change grows from people
                        coming together around shared values, dignity
                        and justice.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="get-involved-cta">

        <div class="container">

            <div class="get-involved-cta-content">

                <span class="section-label">
                    START TODAY
                </span>

                <h2>
                    Ready to get involved?
                </h2>

                <p>
                    Contact us to find out how you can contribute to
                    SisterLove South Africa's work.
                </p>

                <div class="work-cta-buttons">

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="btn-primary">
                        Contact Us
                    </a>

                    <a asp-controller="Donate"
                       asp-action="Index"
                       class="btn-secondary">
                        Support Our Work
                    </a>

                </div>

            </div>

        </div>

    </section>

</section>