@{
    ViewBag.PageTitle = "Get Involved";
}

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">
        <div class="hero-content">
            <span class="eyebrow">GET INVOLVED</span>
            <h1>
                There is always
                <span>a way to help.</span>
            </h1>
            <p>
                Whether you volunteer your time, build a partnership, 
                support our programmes or help amplify our work — 
                your contribution can make a real difference.
            </p>
            <div class="hero-actions">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                    Start Volunteering
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Donate" asp-action="Index" class="btn btn-outline">
                    Support Our Work
                </a>
            </div>
        </div>

        <!-- Right Side: Image with Circle Overlay -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle">
                <div class="gi-hero-image" style="background-image: url('/images/get-involved2.jpg');"></div>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-hands-holding-heart"></i>
                <div>
                    <strong>Love in Action</strong>
                    <span>Community • Justice • Action</span>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- =============================================
     WAYS TO GET INVOLVED
============================================== -->
<section class="focus-section gi-ways-section">
    <div class="container">
        <div class="section-heading">
            <span class="section-label">TAKE ACTION</span>
            <h2>Four simple ways to make an impact</h2>
            <p>Pick what fits your time, your skills and your passion.</p>
        </div>

        <div class="focus-grid gi-ways-grid">
            <!-- Volunteer -->
            <article class="focus-card focus-purple">
                <div class="focus-icon"><i class="fas fa-hands-helping"></i></div>
                <h3>Volunteer</h3>
                <p>Give your time, skills and experience to support community-led work and initiatives.</p>
                <a asp-controller="Contact" asp-action="Index">
                    Volunteer with us <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- Partner -->
            <article class="focus-card focus-blue">
                <div class="focus-icon"><i class="fas fa-handshake"></i></div>
                <h3>Become a Partner</h3>
                <p>Work with SisterLove to develop meaningful programmes and community collaborations.</p>
                <a asp-controller="Contact" asp-action="Index">
                    Explore partnership <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- Donate -->
            <article class="focus-card focus-magenta">
                <div class="focus-icon"><i class="fas fa-heart"></i></div>
                <h3>Support Our Work</h3>
                <p>Financial support helps us continue our programmes, community engagement and advocacy.</p>
                <a asp-controller="Donate" asp-action="Index">
                    Support our work <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- Spread the Word -->
            <article class="focus-card focus-turquoise">
                <div class="focus-icon"><i class="fas fa-bullhorn"></i></div>
                <h3>Spread the Word</h3>
                <p>Help raise awareness by sharing our work, initiatives and messages with your networks.</p>
                <a href="#">
                    Follow our work <i class="fas fa-arrow-right"></i>
                </a>
            </article>
        </div>
    </div>
</section>


<!-- =============================================
     VOLUNTEER SPOTLIGHT
============================================== -->
<section class="identity-section gi-volunteer-section">
    <div class="container identity-grid">
        
        <!-- Visual Side -->
        <div class="identity-visual gi-volunteer-visual">
            <div class="gi-volunteer-circle-grid gi-grid-two">
                <!-- Large circle with your image -->
                <div class="gi-volunteer-circle gi-circle-1" 
                     style="background-image: url('/images/get-involved2.jpg');"></div>
                
                <!-- Small accent circle with icon -->
                <div class="gi-volunteer-circle gi-circle-2 gi-accent-circle">
                    <i class="fas fa-hands-helping"></i>
                </div>
            </div>
        </div>

        <!-- Content Side -->
        <div class="identity-content gi-volunteer-content">
            <span class="section-label">VOLUNTEERING</span>
            <h2>Your time can make a difference.</h2>
            <p>
                SisterLove South Africa is currently volunteer-driven. 
                We work with people who contribute their skills, 
                knowledge and time to advance our mission.
            </p>
            <p>
                If you're interested in volunteering, use our contact 
                form and select <strong>Volunteering</strong> as your 
                reason for contacting us.
            </p>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                Volunteer with us
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">START TODAY</span>
            <h2>Ready to get involved?</h2>
            <p>
                Contact us to find out how you can contribute to 
                SisterLove South Africa's work.
            </p>
            <div class="cta-actions">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-light">
                    Contact Us
                </a>
                <a asp-controller="Donate" asp-action="Index" class="btn btn-outline-light">
                    Support Our Work
                </a>
            </div>
        </div>
    </div>
</section>