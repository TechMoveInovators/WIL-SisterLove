@{
    ViewBag.PageTitle = "Our Work";
}

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">
            <span class="eyebrow">OUR WORK</span>
            <h1>
                Turning love into
                <span>action.</span>
            </h1>
            <p>
                SisterLove South Africa works with communities and
                partners to advance health, justice, dignity and
                opportunity for women, young people and families.
            </p>
            <div class="hero-actions">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                    Get Involved
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Donate" asp-action="Index" class="btn btn-outline">
                    Support Our Work
                </a>
            </div>
        </div>

        <!-- Circular hero image -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle">
                <div class="gi-hero-image" 
                     style="background-image: url('/images/our-work-hero.jpg');"></div>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-hand-holding-heart"></i>
                <div>
                    <strong>Community Rooted</strong>
                    <span>Health • Justice • Dignity</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     INTRODUCTION + STATS
============================================== -->
<section class="intro-section">
    <div class="container intro-grid">

        <div>
            <span class="section-label">WHAT WE DO</span>
            <h2>
                Community-led work
                for lasting change.
            </h2>
            <p style="margin-top: 1.5rem;">
                Our work is grounded in sexual and reproductive
                health and justice, HIV prevention and education,
                gender justice, youth empowerment and meaningful
                community engagement.
            </p>
            <p>
                We work through education, prevention, support,
                research, advocacy, partnerships and community
                participation.
            </p>
        </div>

        <!-- Stats side -->
        <div class="work-stats">
            <div class="work-stat">
                <span class="work-stat-number">5</span>
                <span class="work-stat-label">Focus Areas</span>
            </div>
            <div class="work-stat">
                <span class="work-stat-number">9+</span>
                <span class="work-stat-label">Provinces Reached</span>
            </div>
            <div class="work-stat">
                <span class="work-stat-number">100%</span>
                <span class="work-stat-label">Community-Led</span>
            </div>
            <div class="work-stat">
                <span class="work-stat-number">∞</span>
                <span class="work-stat-label">Love in Action</span>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     FOCUS AREAS — EDITORIAL LIST
============================================== -->
<section class="focus-section" id="our-work">
    <div class="container">

        <div class="section-heading">
            <span class="section-label">OUR FOCUS AREAS</span>
            <h2>Where we make a difference</h2>
            <p>
                Our programmes and initiatives respond to issues
                affecting communities across South Africa.
            </p>
        </div>

        <div class="focus-areas-list">

            <!-- 01 HIV Prevention -->
            <article class="focus-area focus-area-purple">
                <div class="focus-area-number">01</div>
                <div class="focus-area-content">
                    <div class="focus-area-icon">
                        <i class="fas fa-ribbon"></i>
                    </div>
                    <h3>HIV Prevention &amp; Education</h3>
                    <p>
                        Supporting HIV prevention and education through
                        community engagement, awareness and access to
                        relevant information for women, girls and young
                        people.
                    </p>
                </div>
            </article>

            <!-- 02 SRHR -->
            <article class="focus-area focus-area-turquoise">
                <div class="focus-area-number">02</div>
                <div class="focus-area-content">
                    <div class="focus-area-icon">
                        <i class="fas fa-heart-pulse"></i>
                    </div>
                    <h3>Sexual &amp; Reproductive Health &amp; Justice</h3>
                    <p>
                        Promoting access to information, support and
                        rights relating to sexual and reproductive
                        health and justice — including bodily autonomy
                        and freedom from violence.
                    </p>
                </div>
            </article>

            <!-- 03 GBVF -->
            <article class="focus-area focus-area-magenta">
                <div class="focus-area-number">03</div>
                <div class="focus-area-content">
                    <div class="focus-area-icon">
                        <i class="fas fa-hand-fist"></i>
                    </div>
                    <h3>Gender-Based Violence &amp; Femicide</h3>
                    <p>
                        Working to prevent gender-based violence and
                        femicide while promoting dignity, safety,
                        equality and human rights across communities.
                    </p>
                </div>
            </article>

            <!-- 04 Youth -->
            <article class="focus-area focus-area-blue">
                <div class="focus-area-number">04</div>
                <div class="focus-area-content">
                    <div class="focus-area-icon">
                        <i class="fas fa-futbol"></i>
                    </div>
                    <h3>Youth Empowerment Through Sport</h3>
                    <p>
                        Using education, sport and community engagement
                        to create opportunities for young people and
                        support their development and leadership.
                    </p>
                </div>
            </article>

            <!-- 05 Partnerships -->
            <article class="focus-area focus-area-peach">
                <div class="focus-area-number">05</div>
                <div class="focus-area-content">
                    <div class="focus-area-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h3>Partnerships &amp; Collaboration</h3>
                    <p>
                        Building relationships with civil society,
                        government, local stakeholders and community
                        organisations to strengthen collective action.
                    </p>
                </div>
            </article>

        </div>

    </div>
</section>


<!-- =============================================
     HOW WE WORK (with circular image)
============================================== -->
<section class="identity-section">
    <div class="container identity-grid">

        <!-- Circular image side -->
        <div class="identity-visual gi-volunteer-visual">
            <div class="gi-volunteer-image-circle">
                <div class="gi-volunteer-image" 
                     style="background-image: url('/images/our-work-community.jpg');"></div>
            </div>
            <div class="floating-card gi-volunteer-badge">
                <i class="fas fa-users"></i>
                <div>
                    <strong>Locally Led</strong>
                    <span>Community • Justice • Action</span>
                </div>
            </div>
        </div>

        <!-- Content side -->
        <div class="identity-content">
            <span class="section-label">HOW WE WORK</span>
            <h2>
                Locally led.
                Community driven.
            </h2>
            <p>
                SisterLove South Africa is locally led,
                community-based and grounded in feminist and
                human-rights principles.
            </p>
            <p>
                Our organisation is volunteer-driven and supported
                by consultants who work alongside partners,
                civil society organisations, government and local
                stakeholders.
            </p>

            <!-- Three inline principles -->
            <div class="work-principles">
                <div class="work-principle">
                    <i class="fas fa-users"></i>
                    <div>
                        <strong>Community Leadership</strong>
                        <span>Communities are central to the change we seek.</span>
                    </div>
                </div>
                <div class="work-principle">
                    <i class="fas fa-scale-balanced"></i>
                    <div>
                        <strong>Human Rights</strong>
                        <span>We work toward dignity, equality and justice.</span>
                    </div>
                </div>
                <div class="work-principle">
                    <i class="fas fa-heart"></i>
                    <div>
                        <strong>Love in Action</strong>
                        <span>We turn compassion into meaningful action.</span>
                    </div>
                </div>
            </div>

            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary" style="margin-top:1.5rem;">
                Work With Us
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">GET INVOLVED</span>
            <h2>
                Change happens
                when we act together.
            </h2>
            <p>
                Partner with us, volunteer your time or support
                our work in advancing health, justice and dignity.
            </p>
            <div class="cta-actions">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-light">
                    Get Involved
                </a>
                <a asp-controller="Donate" asp-action="Index" class="btn btn-outline-light">
                    Support Our Work
                </a>
            </div>
        </div>
    </div>
</section>