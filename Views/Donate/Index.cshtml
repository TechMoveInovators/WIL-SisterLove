@model SisterLoveSA.Models.DonationViewModel

@{
    ViewBag.PageTitle = "Support Our Work";
}

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">
            <span class="eyebrow">SUPPORT OUR WORK</span>
            <h1>
                Support our work.
                <span>Create change.</span>
            </h1>
            <p>
                Your support helps SisterLove South Africa continue
                community-rooted work in HIV prevention, sexual and
                reproductive health and justice, GBVF prevention,
                youth empowerment and community engagement.
            </p>
            <div class="hero-actions">
                <a href="#donate-form" class="btn btn-primary">
                    Make a Donation
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Home" asp-action="OurWork" class="btn btn-outline">
                    See Our Impact
                </a>
            </div>
        </div>

        <!-- Circular hero image -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle">
                <div class="gi-hero-image"
                     style="background-image: url('/images/donate-hero.jpg');"></div>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-heart"></i>
                <div>
                    <strong>Love in Action</strong>
                    <span>Community • Justice • Action</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     WHY DONATE — 3 Focus Cards
============================================== -->
<section class="focus-section">
    <div class="container">
        <div class="section-heading">
            <span class="section-label">WHY IT MATTERS</span>
            <h2>Three ways your gift creates change</h2>
            <p>
                Your support directly powers the programmes that
                advance health, justice and dignity across South Africa.
            </p>
        </div>

        <div class="focus-grid">
            <article class="focus-card focus-purple">
                <div class="focus-icon">
                    <i class="fas fa-people-group"></i>
                </div>
                <h3>Community Programmes</h3>
                <p>
                    Education, awareness and community engagement
                    that reach women, girls and young people where
                    they live.
                </p>
            </article>

            <article class="focus-card focus-turquoise">
                <div class="focus-icon">
                    <i class="fas fa-heart-pulse"></i>
                </div>
                <h3>Health &amp; Prevention</h3>
                <p>
                    Strengthening HIV prevention, sexual and
                    reproductive health and justice work across
                    our partner communities.
                </p>
            </article>

            <article class="focus-card focus-magenta">
                <div class="focus-icon">
                    <i class="fas fa-hand-holding-heart"></i>
                </div>
                <h3>Youth &amp; Gender Justice</h3>
                <p>
                    Youth empowerment, GBVF prevention and community
                    advocacy that helps shape a safer, fairer future.
                </p>
            </article>
        </div>
    </div>
</section>


<!-- =============================================
     DONATION FORM
============================================== -->
<section class="donate-new-section" id="donate-form">
    <div class="container">

        <div class="donate-new-header">
            <span class="section-label">MAKE A DONATION</span>
            <h2>Choose how you'd like to help.</h2>
            <p>Every contribution — big or small — moves our work forward.</p>
        </div>

        <div class="donate-new-layout">

            <!-- LEFT: Impact Sidebar -->
            <aside class="donate-new-aside">

                <div class="donate-new-quote">
                    <i class="fas fa-quote-left"></i>
                    <p>
                        Love in action means showing up for one another.
                        Your gift is that love, made visible.
                    </p>
                    <span>— SisterLove South Africa</span>
                </div>

                <div class="donate-new-facts">
                    <div class="donate-new-fact">
                        <strong>100%</strong>
                        <span>Community-rooted</span>
                    </div>
                    <div class="donate-new-fact">
                        <strong>9+</strong>
                        <span>Provinces</span>
                    </div>
                    <div class="donate-new-fact">
                        <strong>∞</strong>
                        <span>Love in Action</span>
                    </div>
                </div>

                <div class="donate-note">
                    <i class="fas fa-circle-info"></i>
                    <p>
                        We are actively seeking funding, programme
                        partnerships, corporate support, in-kind support
                        and strategic collaboration.
                    </p>
                </div>

            </aside>


            <!-- RIGHT: Donation Form -->
            <div class="donate-new-form">

                <div class="donate-new-form-header">
                    <i class="fas fa-hand-holding-heart"></i>
                    <div>
                        <h3>Make a contribution</h3>
                        <p>Every contribution helps us continue our work.</p>
                    </div>
                </div>

                <form asp-action="Index" method="post" novalidate>

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger validation-summary"></div>

                    <div class="donate-fields-row">

                        <div class="form-field">
                            <label asp-for="DonorName">Full Name</label>
                            <input asp-for="DonorName"
                                   placeholder="Enter your full name"
                                   autocomplete="name" />
                            <span asp-validation-for="DonorName" class="field-error"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email"
                                   type="email"
                                   placeholder="you@example.com"
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                    </div>

                    <!-- DONATION TYPE -->
                    <div class="form-field">
                        <label>Donation Type</label>

                        <div class="donation-type-options">

                            <label class="radio-card">
                                <input type="radio" asp-for="DonationType" value="0" checked />
                                <span class="radio-content">
                                    <strong>One-Time</strong>
                                    <small>Make a single contribution</small>
                                </span>
                            </label>

                            <label class="radio-card">
                                <input type="radio" asp-for="DonationType" value="1" />
                                <span class="radio-content">
                                    <strong>Monthly</strong>
                                    <small>Support us regularly</small>
                                </span>
                            </label>

                        </div>
                    </div>

                    <!-- AMOUNT -->
                    <div class="form-field">
                        <label asp-for="Amount">Choose an Amount</label>

                        <div class="amount-options">
                            @foreach (var amt in Model.PresetAmounts)
                            {
                                <button type="button"
                                        class="amount-btn"
                                        data-amount="@amt"
                                        onclick="setAmount(this, @amt)">
                                    R@(amt.ToString("N0"))
                                </button>
                            }
                        </div>

                        <div class="custom-amount">
                            <span class="currency-prefix">R</span>
                            <input asp-for="Amount"
                                   type="number"
                                   placeholder="Or enter custom amount"
                                   min="1" />
                        </div>

                        <span asp-validation-for="Amount" class="field-error"></span>
                    </div>

                    <!-- MESSAGE -->
                    <div class="form-field">
                        <label asp-for="Message">
                            Message <span class="muted">(Optional)</span>
                        </label>
                        <textarea asp-for="Message"
                                  rows="4"
                                  placeholder="Leave a message for SisterLove South Africa"></textarea>
                        <span asp-validation-for="Message" class="field-error"></span>
                    </div>

                    <!-- SUBMIT -->
                    <button type="submit" class="form-submit">
                        <i class="fas fa-heart"></i>
                        Support Our Work
                        <i class="fas fa-arrow-right"></i>
                    </button>

                    <p class="donate-security">
                        <i class="fas fa-lock"></i>
                        Your information is handled securely.
                    </p>

                </form>

            </div>

        </div>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">BEYOND DONATIONS</span>
            <h2>Other ways to help.</h2>
            <p>
                Not able to donate right now? There are many other ways
                to support our work and advance health, justice and
                dignity for women and girls.
            </p>
            <div class="cta-actions">
                <a asp-controller="Home" asp-action="GetInvolved" class="btn btn-light">
                    Get Involved
                </a>
                <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-light">
                    Partner With Us
                </a>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        function setAmount(button, amt) {
            const amountInput = document.getElementById('Amount');
            if (!amountInput) return;

            amountInput.value = amt;

            document.querySelectorAll('.amount-btn').forEach(btn => {
                btn.classList.remove('selected');
            });
            button.classList.add('selected');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const amountInput = document.getElementById('Amount');
            if (!amountInput) return;

            amountInput.addEventListener('input', function () {
                const val = parseFloat(this.value);
                document.querySelectorAll('.amount-btn').forEach(btn => {
                    const btnVal = parseFloat(btn.dataset.amount);
                    btn.classList.toggle('selected', btnVal === val);
                });
            });
        });
    </script>
}