@model SisterLoveSA.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1>Delete Event</h1>
        <p class="text-muted">
            Please confirm that you want to delete this event.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-8">

            <div class="card shadow-sm border-danger">
                <div class="card-body p-4">

                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong>
                        This action cannot be undone.
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Event Name
                        </dt>

                        <dd class="col-sm-8">
                            @Model.EventName
                        </dd>

                        <dt class="col-sm-4">
                            Description
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Description
                        </dd>

                        <dt class="col-sm-4">
                            Event Date
                        </dt>

                        <dd class="col-sm-8">
                            @Model.EventDate.ToString("dd MMM yyyy, HH:mm")
                        </dd>

                        <dt class="col-sm-4">
                            Venue
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Venue
                        </dd>

                        <dt class="col-sm-4">
                            Created By
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.CreatedByUserId.HasValue
                                ? $"User #{Model.CreatedByUserId.Value}"
                                : "Not assigned")
                        </dd>

                    </dl>

                    <hr />

                    <form asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger">
                                Yes, Delete Event
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>