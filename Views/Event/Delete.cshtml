@model IEnumerable<SisterLoveSA.Models.EventViewModel>

@{
    ViewData["Title"] = "Events";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-2">Events</h1>
            <p class="text-muted mb-0">
                View and manage SisterLove South Africa events.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Create Event
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Created By</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>
                                <strong>@eventItem.EventName</strong>
                            </td>

                            <td>
                                @eventItem.Description
                            </td>

                            <td>
                                @eventItem.EventDate.ToString("dd MMM yyyy, HH:mm")
                            </td>

                            <td>
                                @eventItem.Venue
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(eventItem.CreatedBy)
                                    ? "Not specified"
                                    : eventItem.CreatedBy)
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@eventItem.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@eventItem.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No events have been created yet.
        </div>
    }

</div>