@model SisterLoveSA.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1>Create Event</h1>
        <p class="text-muted">
            Add a new event for SisterLove South Africa.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventName"
                                   class="form-label">
                            </label>

                            <input asp-for="EventName"
                                   class="form-control"
                                   placeholder="Enter event name" />

                            <span asp-validation-for="EventName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter event description">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate"
                                   class="form-label">
                            </label>

                            <input asp-for="EventDate"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="EventDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Venue"
                                   class="form-label">
                            </label>

                            <input asp-for="Venue"
                                   class="form-control"
                                   placeholder="Enter event venue" />

                            <span asp-validation-for="Venue"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CreatedBy"
                                   class="form-label">
                            </label>

                            <input asp-for="CreatedBy"
                                   class="form-control"
                                   placeholder="Enter creator name" />

                            <span asp-validation-for="CreatedBy"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Event
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}