@{ ViewBag.PageTitle = "Accessibility Statement"; }
<section style="padding: 4rem 0;">
    <div class="container" style="max-width:800px;">
        <h1>Accessibility Statement</h1>
        <p><strong>Last Updated:</strong> @DateTime.Now.ToString("dd MMMM yyyy")</p>
        <h2>Our Commitment</h2>
        <p>SisterLove South Africa is committed to ensuring our website is accessible to everyone.</p>
        <h2>Standards</h2>
        <p>We comply with WCAG 2.1 Level AA guidelines.</p>
        <h2>Features</h2>
        <ul>
            <li>Responsive design</li>
            <li>Keyboard navigation</li>
            <li>Screen reader compatible</li>
            <li>Color contrast optimized</li>
        </ul>
        <h2>Feedback</h2>
        <p>Please <a href="/contact">contact us</a> with any accessibility issues.</p>
    </div>
</section>