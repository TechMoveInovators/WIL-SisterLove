@{ ViewBag.PageTitle = "Privacy Policy"; }
<section style="padding: 4rem 0;">
    <div class="container" style="max-width:800px;">
        <h1>Privacy Policy</h1>
        <p><strong>Last Updated:</strong> @DateTime.Now.ToString("dd MMMM yyyy")</p>
        <h2>1. Introduction</h2>
        <p>We are committed to protecting your privacy in accordance with POPIA.</p>
        <h2>2. Information We Collect</h2>
        <p>Name, email, phone, donation information, and website usage data.</p>
        <h2>3. How We Use Your Information</h2>
        <p>To process donations, respond to inquiries, and improve our services.</p>
        <h2>4. Data Security</h2>
        <p>We use SSL encryption and appropriate safeguards.</p>
        <h2>5. Your Rights</h2>
        <p>Under POPIA you may access, correct, or object to processing your information.</p>
    </div>
</section>