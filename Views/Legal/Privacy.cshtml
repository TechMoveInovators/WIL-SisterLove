@{
    ViewBag.PageTitle = "Privacy Policy";
}

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">
            <span class="eyebrow">PRIVACY POLICY</span>
            <h1>
                Your privacy
                <span>is protected.</span>
            </h1>
            <p>
                We are committed to protecting your personal information
                in accordance with the Protection of Personal Information
                Act (POPIA) of South Africa.
            </p>
            <div class="hero-actions">
                <a href="#sections" class="btn btn-primary">
                    Read the Policy
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Contact" asp-action="Index" class="btn btn-outline">
                    Privacy Questions
                </a>
            </div>
        </div>

        <!-- Circular hero visual with icon -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle gi-shield-circle">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-lock"></i>
                <div>
                    <strong>POPIA Compliant</strong>
                    <span>Secure • Transparent • Trusted</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     INTRODUCTION
============================================== -->
<section class="intro-section">
    <div class="container intro-grid">

        <div>
            <span class="section-label">OUR COMMITMENT</span>
            <h2>
                Your trust matters
                to us.
            </h2>
        </div>

        <div>
            <p>
                This Privacy Policy explains how SisterLove South Africa
                collects, uses, stores and protects your personal
                information when you interact with our website, make a
                donation, or contact us.
            </p>
            <p>
                <strong>Last updated:</strong>
                @DateTime.Now.ToString("dd MMMM yyyy")
            </p>
        </div>

    </div>
</section>


<!-- =============================================
     POLICY SECTIONS
============================================== -->
<section class="focus-section" id="sections">
    <div class="container">

        <div class="section-heading">
            <span class="section-label">POLICY DETAILS</span>
            <h2>What you need to know</h2>
            <p>
                Below is a summary of the key points in our Privacy
                Policy. For the full legal text or any specific
                questions, please contact us.
            </p>
        </div>

        <div class="privacy-grid">

            <!-- 1. Introduction -->
            <article class="privacy-card">
                <div class="privacy-card-icon">
                    <i class="fas fa-file-contract"></i>
                </div>
                <div class="privacy-card-content">
                    <span class="privacy-card-number">01</span>
                    <h3>Introduction</h3>
                    <p>
                        SisterLove South Africa is committed to protecting
                        your privacy and processing your personal
                        information lawfully, fairly and transparently in
                        accordance with POPIA.
                    </p>
                </div>
            </article>

            <!-- 2. Information We Collect -->
            <article class="privacy-card">
                <div class="privacy-card-icon">
                    <i class="fas fa-database"></i>
                </div>
                <div class="privacy-card-content">
                    <span class="privacy-card-number">02</span>
                    <h3>Information We Collect</h3>
                    <p>
                        We may collect your name, email address, phone
                        number, donation details and general website
                        usage data when you interact with our site or
                        services.
                    </p>
                </div>
            </article>

            <!-- 3. How We Use Your Information -->
            <article class="privacy-card">
                <div class="privacy-card-icon">
                    <i class="fas fa-gears"></i>
                </div>
                <div class="privacy-card-content">
                    <span class="privacy-card-number">03</span>
                    <h3>How We Use Your Information</h3>
                    <p>
                        Your information is used to process donations,
                        respond to your inquiries, send updates you have
                        requested, and improve our services and website
                        experience.
                    </p>
                </div>
            </article>

            <!-- 4. Data Security -->
            <article class="privacy-card">
                <div class="privacy-card-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <div class="privacy-card-content">
                    <span class="privacy-card-number">04</span>
                    <h3>Data Security</h3>
                    <p>
                        We use SSL encryption, secure servers and
                        appropriate organisational safeguards to protect
                        your data from unauthorised access, disclosure or
                        loss.
                    </p>
                </div>
            </article>

            <!-- 5. Your Rights -->
            <article class="privacy-card">
                <div class="privacy-card-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="privacy-card-content">
                    <span class="privacy-card-number">05</span>
                    <h3>Your Rights</h3>
                    <p>
                        Under POPIA, you have the right to access, correct
                        or object to the processing of your personal
                        information. To exercise any of these rights,
                        please contact us.
                    </p>
                </div>
            </article>

        </div>

    </div>
</section>


<!-- =============================================
     CONTACT FOR PRIVACY QUESTIONS
============================================== -->
<section class="identity-section">
    <div class="container identity-grid">

        <!-- Content side -->
        <div class="identity-content">
            <span class="section-label">PRIVACY CONTACT</span>
            <h2>
                Questions about
                your data?
            </h2>
            <p>
                If you have any questions about this Privacy Policy or
                how we handle your personal information, our team is
                here to help.
            </p>
            <p>
                You may also request access to the personal information
                we hold about you, or ask us to update or delete it.
            </p>

            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary" style="margin-top:1.5rem;">
                Contact Us
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <!-- Contact info side -->
        <div class="identity-visual">
            <div class="work-principles" style="margin-top:0; padding-top:0; border-top:none;">
                <div class="work-principle">
                    <i class="fas fa-envelope"></i>
                    <div>
                        <strong>Email</strong>
                        <span>info@sisterlove.org.za</span>
                    </div>
                </div>
                <div class="work-principle">
                    <i class="fas fa-phone"></i>
                    <div>
                        <strong>Call Us</strong>
                        <span>+27 (0) 11 123 4567</span>
                    </div>
                </div>
                <div class="work-principle">
                    <i class="fas fa-file-shield"></i>
                    <div>
                        <strong>Data Requests</strong>
                        <span>Access, correct or delete your information</span>
                    </div>
                </div>
                <div class="work-principle">
                    <i class="fas fa-clock"></i>
                    <div>
                        <strong>Response Time</strong>
                        <span>We aim to respond within 48 hours</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">RELATED POLICIES</span>
            <h2>
                Explore our
                other policies.
            </h2>
            <p>
                Learn more about how we protect your rights, data and
                ensure equal access for everyone.
            </p>
            <div class="cta-actions">
                <a asp-controller="Legal" asp-action="Terms" class="btn btn-light">
                    Terms &amp; Conditions
                </a>
                <a asp-controller="Legal" asp-action="Accessibility" class="btn btn-outline-light">
                    Accessibility
                </a>
            </div>
        </div>
    </div>
</section>