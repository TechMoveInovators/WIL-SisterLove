@model SisterLoveSA.Models.ContactViewModel

@{
    ViewBag.PageTitle = "Contact Us";
}

<!-- =============================================
     BULLETPROOF INLINE STYLES (NO ERRORS)
============================================== -->
<style>
    .contact-modern-section {
        padding: 6rem 0;
        background: #faf8f0;
    }

    .contact-modern-layout {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 3rem;
        max-width: 1100px;
        margin: 0 auto;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* Left Info Card */
    .contact-info-card {
        background: linear-gradient(150deg, #24143d 0%, #3d1d68 100%);
        border-radius: 24px;
        padding: 3rem 2.5rem;
        color: #ffffff;
        box-shadow: 0 20px 50px rgba(36, 20, 61, 0.25);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .contact-info-card h2 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }

    .contact-info-card p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 1rem;
        margin-bottom: 2.5rem;
        line-height: 1.6;
    }

    .contact-info-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .contact-info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        text-decoration: none;
        color: #ffffff;
        transition: transform 0.2s;
    }

    .contact-info-item:hover {
        transform: translateX(5px);
    }

    .contact-info-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        color: #2ed5c6;
        font-size: 1.2rem;
        transition: background 0.2s, color 0.2s;
    }

    .contact-info-item:hover .contact-info-icon {
        background: #2ed5c6;
        color: #24143d;
    }

    .contact-info-text strong {
        display: block;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #2ed5c6;
        margin-bottom: 0.25rem;
    }

    .contact-info-text span {
        display: block;
        font-size: 1rem;
        font-weight: 500;
        color: #ffffff;
    }

    .contact-social {
        display: flex;
        gap: 1rem;
        margin-top: 3rem;
    }

    .contact-social a {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        text-decoration: none;
        transition: all 0.2s;
    }

    .contact-social a:hover {
        background: #c13b8a;
        transform: translateY(-3px);
    }

    /* Right Form Card */
    .contact-form-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(36, 20, 61, 0.08);
        border: 1px solid rgba(61, 29, 104, 0.06);
    }

    .contact-form-header {
        margin-bottom: 2rem;
    }

    .contact-form-header h3 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #3d1d68;
        margin-bottom: 0.5rem;
    }

    .contact-form-header p {
        color: #6f6462;
        font-size: 0.95rem;
    }

    .contact-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .contact-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .contact-field-full {
        grid-column: span 2;
    }

    .contact-field label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #3d1d68;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .contact-field label .muted {
        text-transform: none;
        letter-spacing: normal;
        font-weight: 400;
        color: #6f6462;
    }

    .contact-field input,
    .contact-field select,
    .contact-field textarea {
        width: 100%;
        padding: 1rem 1.25rem;
        font-size: 0.95rem;
        font-family: inherit;
        color: #4a3a3a;
        background: #f8f6fb;
        border: 2px solid #e8e0ee;
        border-radius: 12px;
        transition: all 0.2s;
    }

    .contact-field input:focus,
    .contact-field select:focus,
    .contact-field textarea:focus {
        outline: none;
        border-color: #3d1d68;
        background: #ffffff;
        box-shadow: 0 0 0 5px rgba(61, 29, 104, 0.1);
    }

    .contact-field textarea {
        resize: vertical;
        min-height: 150px;
    }

    .contact-field select {
        appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233d1d68' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1.25rem center;
        background-size: 1rem;
        padding-right: 3rem;
        cursor: pointer;
    }

    .contact-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin: 1.5rem 0 2rem;
        padding: 1rem 1.25rem;
        background: rgba(46, 213, 198, 0.05);
        border: 2px solid rgba(46, 213, 198, 0.2);
        border-radius: 12px;
        cursor: pointer;
    }

    .contact-checkbox input[type="checkbox"] {
        width: 1.2rem;
        height: 1.2rem;
        margin-top: 0.15rem;
        accent-color: #2ed5c6;
        cursor: pointer;
        flex-shrink: 0;
    }

    .contact-checkbox span {
        font-size: 0.9rem;
        color: #3d1d68;
        font-weight: 500;
        line-height: 1.5;
    }

    .contact-submit {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1.25rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #3d1d68 0%, #c13b8a 100%);
        border: none;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 12px 30px rgba(193, 59, 138, 0.3);
    }

    .contact-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(193, 59, 138, 0.4);
    }

    .field-error, .text-danger {
        color: #c0392b;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">
            <span class="eyebrow">GET IN TOUCH</span>
            <h1>
                Let's start a
                <span>conversation.</span>
            </h1>
            <p>
                Whether you want to learn more about our work, explore a
                partnership, volunteer your time, or support our programmes
                — we'd love to hear from you.
            </p>
            <div class="hero-actions">
                <a href="#contact-form" class="btn btn-primary">
                    Send a Message
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Home" asp-action="GetInvolved" class="btn btn-outline">
                    Get Involved
                </a>
            </div>
        </div>

        <!-- Circular hero image -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle">
                <div class="gi-hero-image"
                     style="background-image: url('/images/contact-hero.jpg');"></div>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-envelope-open-text"></i>
                <div>
                    <strong>Say Hello</strong>
                    <span>Partnership • Volunteer • Support</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     CONTACT INFO CARDS
============================================== -->
<section class="intro-section">
    <div class="container">

        <div class="section-heading" style="text-align: center; margin-bottom: 3rem;">
            <span class="section-label">HOW TO REACH US</span>
            <h2>We'd love to hear from you.</h2>
            <p style="max-width: 600px; margin: 1rem auto 0;">
                SisterLove South Africa works to advance sexual and
                reproductive health and justice, HIV prevention and
                education, gender justice, and youth empowerment.
            </p>
        </div>

        <div class="focus-grid">

            <!-- Programme Lead -->
            <article class="focus-card focus-purple">
                <div class="focus-icon">
                    <i class="fas fa-user"></i>
                </div>
                <h3>Programme Lead</h3>
                <p>
                    <strong style="color: var(--purple);">Dr Busi Ndlovu</strong><br />
                    <a href="tel:+27824611985" style="color: var(--magenta); text-decoration: none;">
                        +27 82 461 1985
                    </a><br />
                    <a href="mailto:bndlovu@SisterLove.org" style="color: var(--magenta); text-decoration: none;">
                        bndlovu@SisterLove.org
                    </a>
                </p>
            </article>

            <!-- Operations -->
            <article class="focus-card focus-turquoise">
                <div class="focus-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <h3>Operations</h3>
                <p>
                    <strong style="color: var(--purple);">Nomsa Mothapo</strong><br />
                    <a href="tel:+27796665075" style="color: var(--magenta); text-decoration: none;">
                        +27 79 666 5075
                    </a><br />
                    <a href="mailto:nmothapo@SisterLove.org" style="color: var(--magenta); text-decoration: none;">
                        nmothapo@SisterLove.org
                    </a>
                </p>
            </article>

            <!-- Postal Address -->
            <article class="focus-card focus-magenta">
                <div class="focus-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <h3>Postal Address</h3>
                <p>
                    Suite 116, P.Bag X2600<br />
                    Killarney, 2041<br />
                    South Africa
                </p>
            </article>

        </div>

        <!-- VAT note -->
        <div style="text-align: center; margin-top: 3rem;">
            <div class="contact-vat-pill" style="display: inline-flex;">
                <span>VAT Number</span>
                <strong>4690278157</strong>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     CONTACT FORM (MODERN SPLIT LAYOUT)
============================================== -->
<section class="contact-modern-section" id="contact-form">
    <div class="container">

        <!-- Success message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="contact-banner-success" role="status" style="max-width: 1100px; margin: 0 auto 2rem; background: #e8f8f5; padding: 1rem; border-radius: 12px; border: 1px solid #2ed5c6; color: #0d9488;">
                <i class="fas fa-circle-check" style="margin-right: 8px;"></i>
                <strong>Message sent successfully.</strong> @TempData["SuccessMessage"]
            </div>
        }

        <div class="contact-modern-layout">
            
            <!-- Left Side: Info Card -->
            <div class="contact-info-card">
                <div>
                    <h2>Let's connect.</h2>
                    <p>Have a question, want to partner with us, or just want to say hello? We'd love to hear from you.</p>
                    
                    <div class="contact-info-list">
                        <a href="mailto:hello@sisterlove.org.za" class="contact-info-item">
                            <div class="contact-info-icon"><i class="fas fa-envelope"></i></div>
                            <div class="contact-info-text">
                                <strong>Email Us</strong>
                                <span>hello@sisterlove.org.za</span>
                            </div>
                        </a>
                        <a href="tel:+27123456789" class="contact-info-item">
                            <div class="contact-info-icon"><i class="fas fa-phone-alt"></i></div>
                            <div class="contact-info-text">
                                <strong>Call Us</strong>
                                <span>+27 (0) 12 345 6789</span>
                            </div>
                        </a>
                        <div class="contact-info-item">
                            <div class="contact-info-icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div class="contact-info-text">
                                <strong>Visit Us</strong>
                                <span>123 Main Street, Johannesburg, 2001</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="contact-social">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>

            <!-- Right Side: Form Card -->
            <div class="contact-form-card">
                <div class="contact-form-header">
                    <h3>Send a message</h3>
                    <p>Fill out the form below and we will get back to you shortly.</p>
                </div>

                <form asp-controller="Contact" asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

                    <div class="contact-form-grid">
                        <!-- Full Name -->
                        <div class="contact-field contact-field-full">
                            <label asp-for="Name">Full Name</label>
                            <input asp-for="Name" placeholder="Enter your full name" autocomplete="name" />
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>

                        <!-- Email -->
                        <div class="contact-field">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <!-- Phone -->
                        <div class="contact-field">
                            <label asp-for="Phone">Phone Number <span class="muted">(Optional)</span></label>
                            <input asp-for="Phone" type="tel" placeholder="+27 XX XXX XXXX" autocomplete="tel" />
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>

                        <!-- Subject -->
                        <div class="contact-field contact-field-full">
                            <label asp-for="Subject">Reason for Contact</label>
                            <select asp-for="Subject" asp-items="Html.GetEnumSelectList<SisterLoveSA.Models.InquiryType>()">
                                <option value="">Select a reason</option>
                            </select>
                            <span asp-validation-for="Subject" class="field-error"></span>
                        </div>

                        <!-- Message -->
                        <div class="contact-field contact-field-full">
                            <label asp-for="Message">Your Message</label>
                            <textarea asp-for="Message" placeholder="Tell us how we can help..."></textarea>
                            <span asp-validation-for="Message" class="field-error"></span>
                        </div>
                    </div>

                    <!-- Volunteer Checkbox -->
                    <label class="contact-checkbox">
                        <input asp-for="IsVolunteer" type="checkbox" />
                        <span>I'd like to volunteer with SisterLove South Africa.</span>
                    </label>

                    <!-- Submit Button -->
                    <button type="submit" class="contact-submit">
                        Send Message
                        <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    </button>

                </form>
            </div>

        </div>

        <p style="text-align: center; max-width: 600px; margin: 2rem auto 0; color: var(--muted); font-size: 0.9rem;">
            Thank you for reaching out. Your message helps us connect with people who share our commitment to the community.
        </p>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">FOLLOW OUR WORK</span>
            <h2>Stay connected with us.</h2>
            <p>
                Follow SisterLove South Africa on social media to keep up
                with our programmes, events and community initiatives.
            </p>
            <div class="cta-actions">
                <a href="#" class="btn btn-light">
                    <i class="fab fa-facebook-f" style="margin-right: 0.5rem;"></i>
                    Facebook
                </a>
                <a href="#" class="btn btn-outline-light">
                    <i class="fab fa-instagram" style="margin-right: 0.5rem;"></i>
                    Instagram
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}