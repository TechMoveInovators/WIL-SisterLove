@model SisterLoveSA.Models.ContactViewModel

@{
    ViewBag.PageTitle = "Contact Us";
}

<!-- =============================================
     HERO SECTION
============================================== -->
<section class="hero-section">
    <div class="hero-shape hero-shape-one"></div>
    <div class="hero-shape hero-shape-two"></div>

    <div class="container hero-container">

        <div class="hero-content">
            <span class="eyebrow">GET IN TOUCH</span>
            <h1>
                Let's start a
                <span>conversation.</span>
            </h1>
            <p>
                Whether you want to learn more about our work, explore a
                partnership, volunteer your time, or support our programmes
                — we'd love to hear from you.
            </p>
            <div class="hero-actions">
                <a href="#contact-form" class="btn btn-primary">
                    Send a Message
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Home" asp-action="GetInvolved" class="btn btn-outline">
                    Get Involved
                </a>
            </div>
        </div>

        <!-- Circular hero image -->
        <div class="hero-visual gi-hero-visual">
            <div class="gi-hero-image-circle">
                <div class="gi-hero-image"
                     style="background-image: url('/images/contact-hero.jpg');"></div>
            </div>
            <div class="floating-card gi-floating-card">
                <i class="fas fa-envelope-open-text"></i>
                <div>
                    <strong>Say Hello</strong>
                    <span>Partnership • Volunteer • Support</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     CONTACT INFO CARDS
============================================== -->
<section class="intro-section">
    <div class="container">

        <div class="section-heading" style="text-align: center; margin-bottom: 3rem;">
            <span class="section-label">HOW TO REACH US</span>
            <h2>We'd love to hear from you.</h2>
            <p style="max-width: 600px; margin: 1rem auto 0;">
                SisterLove South Africa works to advance sexual and
                reproductive health and justice, HIV prevention and
                education, gender justice, and youth empowerment.
            </p>
        </div>

        <div class="focus-grid">

            <!-- Programme Lead -->
            <article class="focus-card focus-purple">
                <div class="focus-icon">
                    <i class="fas fa-user"></i>
                </div>
                <h3>Programme Lead</h3>
                <p>
                    <strong style="color: var(--purple);">Dr Busi Ndlovu</strong><br />
                    <a href="tel:+27824611985" style="color: var(--magenta); text-decoration: none;">
                        +27 82 461 1985
                    </a><br />
                    <a href="mailto:bndlovu@SisterLove.org" style="color: var(--magenta); text-decoration: none;">
                        bndlovu@SisterLove.org
                    </a>
                </p>
            </article>

            <!-- Operations -->
            <article class="focus-card focus-turquoise">
                <div class="focus-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <h3>Operations</h3>
                <p>
                    <strong style="color: var(--purple);">Nomsa Mothapo</strong><br />
                    <a href="tel:+27796665075" style="color: var(--magenta); text-decoration: none;">
                        +27 79 666 5075
                    </a><br />
                    <a href="mailto:nmothapo@SisterLove.org" style="color: var(--magenta); text-decoration: none;">
                        nmothapo@SisterLove.org
                    </a>
                </p>
            </article>

            <!-- Postal Address -->
            <article class="focus-card focus-magenta">
                <div class="focus-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <h3>Postal Address</h3>
                <p>
                    Suite 116, P.Bag X2600<br />
                    Killarney, 2041<br />
                    South Africa
                </p>
            </article>

        </div>

        <!-- VAT note -->
        <div style="text-align: center; margin-top: 3rem;">
            <div class="contact-vat-pill" style="display: inline-flex;">
                <span>VAT Number</span>
                <strong>4690278157</strong>
            </div>
        </div>

    </div>
</section>


<!-- =============================================
     CONTACT FORM
============================================== -->
<section class="identity-section" id="contact-form"
         style="background: var(--cream);">

    <div class="container">

        <!-- Success message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="contact-banner-success"
                 role="status"
                 style="max-width: 760px; margin: 0 auto 2rem;">

                <i class="fas fa-circle-check"></i>

                <div>
                    <strong>Message sent successfully</strong>
                    <p>@TempData["SuccessMessage"]</p>
                </div>
            </div>
        }

        <!-- Section heading -->
        <div class="section-heading"
             style="text-align: center; max-width: 760px; margin: 0 auto 2.5rem;">

            <span class="section-label">SEND A MESSAGE</span>

            <h2>How can we help?</h2>

            <p style="max-width: 600px; margin: 1rem auto 0;">
                Whether you have a question about our work, would like to
                explore a partnership, or are interested in volunteering,
                we would love to hear from you.
            </p>
        </div>

        <!-- Contact form card -->
        <div style="
            max-width: 760px;
            margin: 0 auto;
            background: var(--white);
            padding: clamp(1.25rem, 4vw, 2.75rem);
            border-radius: 16px;
            border: 1px solid rgba(113, 56, 181, 0.14);
            box-shadow: 0 12px 35px rgba(36, 20, 61, 0.07);
            ">

            <form asp-controller="Contact"
                  asp-action="Index"
                  method="post"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="form-errors"
                     role="alert">
                </div>

                <!-- Full name -->
                <div class="form-field">
                    <label asp-for="Name">Full Name</label>

                    <input asp-for="Name"
                           placeholder="Enter your full name"
                           autocomplete="name" />

                    <span asp-validation-for="Name"
                          class="field-error">
                    </span>
                </div>

                <!-- Email address -->
                <div class="form-field">
                    <label asp-for="Email">Email Address</label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="you@example.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="field-error">
                    </span>
                </div>

                <!-- Phone number -->
                <div class="form-field">
                    <label asp-for="Phone">
                        Phone Number
                        <span class="muted">(Optional)</span>
                    </label>

                    <input asp-for="Phone"
                           type="tel"
                           placeholder="+27 XX XXX XXXX"
                           autocomplete="tel" />

                    <span asp-validation-for="Phone"
                          class="field-error">
                    </span>
                </div>

                <!-- Reason for contact -->
                <div class="form-field">
                    <label asp-for="Subject">Reason for Contact</label>

                    <select asp-for="Subject"
                            asp-items="Html.GetEnumSelectList<SisterLoveSA.Models.InquiryType>()">
                        <option value="">Select a reason</option>
                    </select>

                    <span asp-validation-for="Subject"
                          class="field-error">
                    </span>
                </div>

                <!-- Message -->
                <div class="form-field">
                    <label asp-for="Message">Your Message</label>

                    <textarea asp-for="Message"
                              rows="6"
                              placeholder="Tell us how we can help..."></textarea>

                    <span asp-validation-for="Message"
                          class="field-error">
                    </span>
                </div>

                <!-- Volunteer interest -->
                <label class="form-checkbox"
                       style="
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    margin: 1.5rem 0;
                    ">

                    <input asp-for="IsVolunteer"
                           type="checkbox"
                           style="margin-top: 0.3rem; flex-shrink: 0;" />

                    <span>
                        I'd like to volunteer with SisterLove South Africa.
                    </span>
                </label>

                <!-- Submit -->
                <button type="submit"
                        class="form-submit"
                        style="
                    width: 100%;
                    justify-content: center;
                    gap: 0.75rem;
                    ">
                    Send Message
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>

            </form>
        </div>

        <p style="
            text-align: center;
            max-width: 600px;
            margin: 1.5rem auto 0;
            color: var(--text-muted, #6b6572);
            font-size: 0.9rem;
            ">
            Thank you for reaching out. Your message helps us connect with
            people who share our commitment to the community.
        </p>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">FOLLOW OUR WORK</span>
            <h2>Stay connected with us.</h2>
            <p>
                Follow SisterLove South Africa on social media to keep up
                with our programmes, events and community initiatives.
            </p>
            <div class="cta-actions">
                <a href="#" class="btn btn-light">
                    <i class="fab fa-facebook-f" style="margin-right: 0.5rem;"></i>
                    Facebook
                </a>
                <a href="#" class="btn btn-outline-light">
                    <i class="fab fa-instagram" style="margin-right: 0.5rem;"></i>
                    Instagram
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}