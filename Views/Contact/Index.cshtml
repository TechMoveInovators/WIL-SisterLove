<!-- =============================================
     CONTACT FORM (MODERN SPLIT LAYOUT)
============================================== -->
<section class="contact-modern-section" id="contact-form">
    <div class="contact-wrap">

        <!-- Success message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="contact-banner-success" role="status">
                <i class="fas fa-circle-check" style="margin-right: 8px;"></i>
                <strong>Message sent successfully.</strong> @TempData["SuccessMessage"]
            </div>
        }

        <div class="contact-modern-layout">

            <!-- Left Side: Info Card -->
            <div class="contact-info-card">
                <div>
                    <h2>Let's connect.</h2>
                    <p>Have a question, want to partner with us, or just want to say hello? We'd love to hear from you.</p>

                    <div class="contact-info-list">
                        <a href="mailto:hello@sisterlove.org.za" class="contact-info-item">
                            <div class="contact-info-icon"><i class="fas fa-envelope"></i></div>
                            <div class="contact-info-text">
                                <strong>Email Us</strong>
                                <span>hello@sisterlove.org.za</span>
                            </div>
                        </a>
                        <a href="tel:+27123456789" class="contact-info-item">
                            <div class="contact-info-icon"><i class="fas fa-phone-alt"></i></div>
                            <div class="contact-info-text">
                                <strong>Call Us</strong>
                                <span>+27 (0) 12 345 6789</span>
                            </div>
                        </a>
                        <div class="contact-info-item">
                            <div class="contact-info-icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div class="contact-info-text">
                                <strong>Visit Us</strong>
                                <span>123 Main Street, Johannesburg, 2001</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="contact-social">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>

            <!-- Right Side: Form Card -->
            <div class="contact-form-card">
                <div class="contact-form-header">
                    <h3>Send a message</h3>
                    <p>Fill out the form below and we will get back to you shortly.</p>
                </div>

                <form asp-controller="Contact" asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

                    <div class="contact-form-grid">
                        <!-- Full Name -->
                        <div class="contact-field contact-field-full">
                            <label asp-for="Name">Full Name</label>
                            <input asp-for="Name" placeholder="Enter your full name" autocomplete="name" />
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>

                        <!-- Email -->
                        <div class="contact-field">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <!-- Phone -->
                        <div class="contact-field">
                            <label asp-for="Phone">Phone Number <span class="muted">(Optional)</span></label>
                            <input asp-for="Phone" type="tel" placeholder="+27 XX XXX XXXX" autocomplete="tel" />
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>

                        <!-- Subject -->
                        <div class="contact-field contact-field-full">
                            <label asp-for="Subject">Reason for Contact</label>
                            <select asp-for="Subject" asp-items="Html.GetEnumSelectList<SisterLoveSA.Models.InquiryType>()">
                                <option value="">Select a reason</option>
                            </select>
                            <span asp-validation-for="Subject" class="field-error"></span>
                        </div>

                        <!-- Message -->
                        <div class="contact-field contact-field-full">
                            <label asp-for="Message">Your Message</label>
                            <textarea asp-for="Message" placeholder="Tell us how we can help..."></textarea>
                            <span asp-validation-for="Message" class="field-error"></span>
                        </div>
                    </div>

                    <!-- Volunteer Checkbox -->
                    <label class="contact-checkbox">
                        <input asp-for="IsVolunteer" type="checkbox" />
                        <span>I'd like to volunteer with SisterLove South Africa.</span>
                    </label>

                    <!-- Submit Button -->
                    <button type="submit" class="contact-submit">
                        Send Message
                        <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    </button>

                </form>
            </div>

        </div>

        <p class="contact-thanks">
            Thank you for reaching out. Your message helps us connect with people who share our commitment to the community.
        </p>

    </div>
</section>


<!-- =============================================
     CTA SECTION
============================================== -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <span class="section-label">FOLLOW OUR WORK</span>
            <h2>Stay connected with us.</h2>
            <p>
                Follow SisterLove South Africa on social media to keep up
                with our programmes, events and community initiatives.
            </p>
            <div class="cta-actions">
                <a href="#" class="btn btn-light">
                    <i class="fab fa-facebook-f" style="margin-right: 0.5rem;"></i>
                    Facebook
                </a>
                <a href="#" class="btn btn-outline-light">
                    <i class="fab fa-instagram" style="margin-right: 0.5rem;"></i>
                    Instagram
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
