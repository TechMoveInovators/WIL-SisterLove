@model SisterLoveSA.Models.UserProfileViewModel
@{
    ViewBag.PageTitle = "My Account";
}

<section style="padding: 4rem 0;">
    <div class="container" style="max-width:700px;">
        <h1 style="text-align:center;">My Account</h1>

        @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
        {
            <div style="background:#e8f5e9;padding:1rem;border-radius:0.5rem;margin:1rem 0;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="Profile" method="post" style="margin-top:2rem;">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email (Read-only)</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MemberSince">Member Since</label>
                <input asp-for="MemberSince" class="form-control" readonly />
            </div>

            <div style="display:flex;gap:1rem;margin-top:1.5rem;">
                <button type="submit" class="btn-primary">Update Info</button>
                <a href="/" class="btn-secondary">Discard</a>
                <a href="/account/logout" style="margin-left:auto;color:#c0392b;">Sign Out</a>
            </div>
        </form>
    </div>
</section>