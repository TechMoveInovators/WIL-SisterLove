<!-- =============================================
     FOOTER STYLES (self-contained, scoped to .sl-footer)
============================================== -->
<style>
    .sl-footer {
        --f-purple: #3d1d68;
        --f-purple-dark: #24143d;
        --f-purple-deep: #1a0f2d;
        --f-turquoise: #2ed5c6;
        --f-magenta: #c13b8a;

        position: relative;
        background: linear-gradient(180deg, var(--f-purple-dark) 0%, var(--f-purple-deep) 100%);
        color: rgba(255, 255, 255, 0.75);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-top: 0;
        overflow: hidden;
    }

    /* Gradient accent bar across the top */
    .sl-footer::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--f-turquoise) 0%, var(--f-magenta) 100%);
    }

    .sl-footer *,
    .sl-footer *::before,
    .sl-footer *::after {
        box-sizing: border-box;
    }

    .sl-footer a {
        color: inherit;
        text-decoration: none;
    }

    .sl-footer h3,
    .sl-footer h4,
    .sl-footer strong {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        text-transform: none;
        letter-spacing: normal;
    }

    .sl-footer .sl-footer-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4.5rem 1.5rem 1.75rem;
    }

    .sl-footer .sl-footer-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ---------- Top: brand + newsletter ---------- */
    .sl-footer .sl-footer-top {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    .sl-footer .sl-footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.25rem;
    }

    .sl-footer .sl-footer-logo-mark {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--f-turquoise) 0%, var(--f-magenta) 100%);
        color: #fff;
        font-size: 1.2rem;
    }

    .sl-footer .sl-footer-logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .sl-footer .sl-footer-logo-text strong {
        font-size: 1.25rem;
        font-weight: 800;
        color: #fff;
    }

    .sl-footer .sl-footer-logo-text span {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--f-turquoise);
    }

    .sl-footer .sl-footer-tagline {
        max-width: 440px;
        margin: 0 0 1.5rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .sl-footer .sl-footer-social {
        display: flex;
        gap: 0.75rem;
    }

    .sl-footer .sl-footer-social a {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        transition: all 0.25s ease;
    }

    .sl-footer .sl-footer-social a:hover {
        background: var(--f-magenta);
        transform: translateY(-3px);
    }

    /* Newsletter card */
    .sl-footer .sl-footer-newsletter {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 2rem;
    }

    .sl-footer .sl-footer-eyebrow {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        color: var(--f-turquoise);
        margin-bottom: 0.5rem;
    }

    .sl-footer .sl-footer-newsletter h3 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 0.5rem;
    }

    .sl-footer .sl-footer-newsletter h3 span {
        color: var(--f-magenta);
    }

    .sl-footer .sl-footer-newsletter p {
        margin: 0 0 1.25rem;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.92rem;
    }

    .sl-footer .sl-footer-newsletter-form {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.08);
        border: 2px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        padding: 0.35rem 0.35rem 0.35rem 1.25rem;
        transition: border-color 0.2s, background 0.2s;
    }

    .sl-footer .sl-footer-newsletter-form:focus-within {
        border-color: var(--f-turquoise);
        background: rgba(255, 255, 255, 0.12);
    }

    .sl-footer .sl-footer-newsletter-form input {
        flex: 1;
        min-width: 0;
        background: transparent;
        border: none;
        outline: none;
        color: #fff;
        font-family: inherit;
        font-size: 0.95rem;
        padding: 0.6rem 0;
    }

    .sl-footer .sl-footer-newsletter-form input::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .sl-footer .sl-footer-newsletter-form button {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--f-turquoise) 0%, var(--f-magenta) 100%);
        color: #fff;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .sl-footer .sl-footer-newsletter-form button:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(193, 59, 138, 0.4);
    }

    .sl-footer .sl-footer-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 3rem 0;
    }

    /* ---------- Middle: link columns ---------- */
    .sl-footer .sl-footer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1.4fr;
        gap: 2.5rem;
    }

    .sl-footer .sl-footer-links h4,
    .sl-footer .sl-footer-contact h4 {
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #fff;
        margin: 0 0 1.25rem;
    }

    .sl-footer .sl-footer-links a {
        display: block;
        padding: 0.3rem 0;
        color: rgba(255, 255, 255, 0.7);
        transition: color 0.2s, transform 0.2s;
    }

    .sl-footer .sl-footer-links a:hover {
        color: var(--f-turquoise);
        transform: translateX(4px);
    }

    .sl-footer .sl-footer-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        margin-bottom: 1rem;
        color: #fff;
    }

    .sl-footer a.sl-footer-contact-item:hover .sl-footer-contact-icon {
        background: var(--f-turquoise);
        color: var(--f-purple-dark);
    }

    .sl-footer .sl-footer-contact-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--f-turquoise);
        font-size: 0.95rem;
        transition: all 0.2s;
    }

    .sl-footer .sl-footer-contact-text {
        font-size: 0.92rem;
        font-weight: 500;
        line-height: 1.4;
        word-break: break-word;
    }

    .sl-footer .sl-footer-contact-text small {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 0.1rem;
    }

    .sl-footer .sl-footer-donate {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.5rem;
        padding: 1rem 1.25rem;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--f-purple) 0%, var(--f-magenta) 100%);
        color: #fff;
        font-weight: 700;
        box-shadow: 0 10px 25px rgba(193, 59, 138, 0.3);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .sl-footer .sl-footer-donate small {
        display: block;
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.8);
    }

    .sl-footer .sl-footer-donate i {
        transition: transform 0.25s ease;
    }

    .sl-footer .sl-footer-donate:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(193, 59, 138, 0.45);
    }

    .sl-footer .sl-footer-donate:hover i {
        transform: translateX(5px);
    }

    /* ---------- Bottom bar ---------- */
    .sl-footer .sl-footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.55);
    }

    .sl-footer .sl-footer-bottom p {
        margin: 0;
    }

    .sl-footer .sl-footer-bottom-links {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .sl-footer .sl-footer-bottom-links a:hover {
        color: var(--f-turquoise);
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1000px) {
        .sl-footer .sl-footer-top {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .sl-footer .sl-footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 600px) {
        .sl-footer .sl-footer-container {
            padding-top: 3rem;
        }

        .sl-footer .sl-footer-newsletter {
            padding: 1.5rem;
        }

        .sl-footer .sl-footer-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .sl-footer .sl-footer-bottom {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<footer class="sl-footer">
    <div class="sl-footer-container">

        <!-- TOP: Brand + Newsletter -->
        <div class="sl-footer-top">

            <div class="sl-footer-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sl-footer-logo">

                    <span class="sl-footer-logo-mark">
                        <i class="fas fa-heart"></i>
                    </span>

                    <span class="sl-footer-logo-text">
                        <strong>SisterLove</strong>
                        <span>South Africa</span>
                    </span>
                </a>

                <p class="sl-footer-tagline">
                    Love in Action — supporting communities through
                    HIV prevention, sexual and reproductive health,
                    gender justice and youth empowerment.
                </p>

                <div class="sl-footer-social">
                    <a href="#" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>

                    <a href="#" aria-label="Twitter">
                        <i class="fab fa-twitter"></i>
                    </a>

                    <a href="#" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>

                    <a href="#" aria-label="LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                </div>

            </div>

            <!-- Newsletter -->
            <div class="sl-footer-newsletter">

                <span class="sl-footer-eyebrow">
                    STAY CONNECTED
                </span>

                <h3>
                    Stay in touch<span>.</span>
                </h3>

                <p>
                    Get updates about our work, programmes and events.
                    Stay connected with the SisterLove South Africa community.
                </p>

                <form class="sl-footer-newsletter-form">
                    <label class="sl-footer-sr-only"
                           for="footer-newsletter-email">
                        Email address
                    </label>

                    <input id="footer-newsletter-email"
                           type="email"
                           name="email"
                           placeholder="Your email address"
                           autocomplete="email"
                           required />

                    <button type="submit"
                            aria-label="Subscribe">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>

            </div>

        </div>

        <div class="sl-footer-divider"></div>

        <!-- MIDDLE: Link columns -->
        <div class="sl-footer-grid">

            <div class="sl-footer-links">
                <h4>Quick Links</h4>

                <a asp-controller="Home"
                   asp-action="Index">Home</a>

                <a asp-controller="Home"
                   asp-action="About">About Us</a>

                <a asp-controller="Contact"
                   asp-action="Index">Contact Us</a>

                <a asp-controller="Donate"
                   asp-action="Index">Support Our Work</a>
            </div>

            <div class="sl-footer-links">
                <h4>Explore</h4>

                <a href="/Home/OurWork">Our Work</a>

                <a href="/Home/Partnerships">Partnerships</a>

                <a href="/Home/TrackRecord">Track Record</a>

                <a href="/Home/GetInvolved">Get Involved</a>
            </div>

            <div class="sl-footer-links">
                <h4>Legal</h4>

                <a asp-controller="Legal"
                   asp-action="Terms">Terms &amp; Conditions</a>

                <a asp-controller="Legal"
                   asp-action="Privacy">Privacy Policy</a>

                <a asp-controller="Legal"
                   asp-action="Accessibility">Accessibility</a>
            </div>

            <div class="sl-footer-contact">
                <h4>Get in Touch</h4>

                <a href="mailto:info@sisterlove.org.za"
                   class="sl-footer-contact-item">

                    <span class="sl-footer-contact-icon">
                        <i class="fas fa-envelope"></i>
                    </span>

                    <span class="sl-footer-contact-text">
                        <small>Email us</small>
                        info@sisterlove.org.za
                    </span>
                </a>

                <a href="tel:+27111234567"
                   class="sl-footer-contact-item">

                    <span class="sl-footer-contact-icon">
                        <i class="fas fa-phone"></i>
                    </span>

                    <span class="sl-footer-contact-text">
                        <small>Call us</small>
                        +27 (0) 11 123 4567
                    </span>
                </a>

                <div class="sl-footer-contact-item">

                    <span class="sl-footer-contact-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </span>

                    <span class="sl-footer-contact-text">
                        <small>Our location</small>
                        Johannesburg,<br />
                        South Africa
                    </span>
                </div>

                <a asp-controller="Donate"
                   asp-action="Index"
                   class="sl-footer-donate">

                    <span>
                        <small>MAKE A DIFFERENCE</small>
                        Support Our Work
                    </span>

                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>

        <!-- BOTTOM: Copyright -->
        <div class="sl-footer-bottom">

            <p>
                &copy; @DateTime.Now.Year SisterLove South Africa.
                All rights reserved.
            </p>

            <div class="sl-footer-bottom-links">
                <a asp-controller="Legal"
                   asp-action="Terms">Terms</a>

                <span>•</span>

                <a asp-controller="Legal"
                   asp-action="Privacy">Privacy</a>

                <span>•</span>

                <a asp-controller="Legal"
                   asp-action="Accessibility">Accessibility</a>
            </div>

        </div>

    </div>
</footer>
